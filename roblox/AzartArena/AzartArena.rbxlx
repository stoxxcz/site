            <string name="Name">Panels</string>
          </Properties>
          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">Bets</string>
              <string name="Source"><![CDATA[-- Панель ставок на победителя раунда (тотализатор).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local UI = require(script.Parent.Parent.UI)

local player = Players.LocalPlayer
local state = Net.State()

local Bets = {}

local pools: { [string]: number } = {}
local mine: { [string]: number } = {}
local total = 0
local thumbnails: { [number]: string } = {}

function Bets.Init(hud)
	local accent = Color3.fromRGB(255, 140, 0)
	local frame, content, close = UI.Panel(hud.Gui(), "🎲 СТАВКИ НА ПОБЕДИТЕЛЯ", UDim2.fromOffset(540, 540), accent)

	local info = UI.Label({
		Size = UDim2.new(1, 0, 0, 26),
		TextColor3 = UI.Colors.Accent,
		Font = UI.FontBlack,
		ZIndex = 6,
		Parent = content,
	})
	local bank = UI.Label({
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.fromOffset(0, 28),
		TextColor3 = UI.Colors.Muted,
		ZIndex = 6,
		Parent = content,
	})
	local amountHolder = UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 80),
		Position = UDim2.fromOffset(0, 54),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = content,
	})
	local amount = UI.AmountSelector(amountHolder, 50)
	local list = UI.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -170),
		Position = UDim2.fromOffset(0, 142),
		BackgroundColor3 = UI.Colors.Panel,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 5,
		Parent = content,
	}, {
		UI.Corner(10),
		UI.Padding(6),
		UI.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	UI.Label({
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.new(0, 0, 1, -20),
		Text = "Угадал победителя — делишь весь банк (+25% от казино + джекпот)!",
		TextColor3 = UI.Colors.Muted,
		Font = UI.Font,
		ZIndex = 6,
		Parent = content,
	})

	local function rebuild()
		for _, child in list:GetChildren() do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		local jackpot = state:GetAttribute("Jackpot") or 0
		local prize = math.floor(total * Config.Betting.HouseBonus) + jackpot
		for i, target in Players:GetPlayers() do
			local key = tostring(target.UserId)
			local pool = pools[key] or 0
			local my = mine[key] or 0
			local row = UI.new("Frame", {
				Size = UDim2.new(1, -4, 0, 54),
				BackgroundColor3 = target == player and Color3.fromRGB(60, 45, 20) or UI.Colors.Panel2,
				LayoutOrder = i,
				ZIndex = 6,
				Parent = list,
			}, {
				UI.Corner(10),
			})
			local avatar = UI.new("ImageLabel", {
				Size = UDim2.fromOffset(44, 44),
				Position = UDim2.fromOffset(5, 5),
				BackgroundColor3 = UI.Colors.Bg,
				Image = thumbnails[target.UserId] or "",
				ZIndex = 7,
				Parent = row,
			}, {
				UI.Corner(22),
			})
			if not thumbnails[target.UserId] then
				task.spawn(function()
					local ok, image = pcall(function()
						return Players:GetUserThumbnailAsync(target.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
					end)
					if ok and image then
						thumbnails[target.UserId] = image
						if avatar.Parent then
							avatar.Image = image
						end
					end
				end)
			end
			UI.Label({
				Text = target.DisplayName .. (target == player and " (ты)" or ""),
				Size = UDim2.new(1, -190, 0, 24),
				Position = UDim2.fromOffset(56, 4),
				TextXAlignment = Enum.TextXAlignment.Left,
				Font = UI.FontBlack,
				ZIndex = 7,
				Parent = row,
			})
			local odds = pool > 0 and string.format("кэф x%.1f", prize / pool) or "кэф —"
			UI.Label({
				Text = string.format(
					'Банк: %s • <font color="#FFC83C">Твоя: %s</font> • %s',
					Config.Format(pool),
					Config.Format(my),
					odds
				),
				Size = UDim2.new(1, -190, 0, 18),
				Position = UDim2.fromOffset(56, 30),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = UI.Colors.Muted,
				ZIndex = 7,
				Parent = row,
			})
			local button = UI.Button("Поставить", UI.Colors.Good, {
				Size = UDim2.fromOffset(120, 40),
				Position = UDim2.new(1, -126, 0, 7),
				ZIndex = 7,
				Parent = row,
			})
			button.Activated:Connect(function()
				Net.Event("PlaceBet"):FireServer(target.UserId, amount.Get())
			end)
		end
	end

	local function refreshInfo()
		local open = state:GetAttribute("BetsOpen") == true
		if open then
			local left = math.max(0, math.ceil((state:GetAttribute("EndsAt") or 0) - Net.Now()))
			info.Text = string.format("Далее: %s • приём ставок %d с", tostring(state:GetAttribute("Next") or ""), left)
		else
			info.Text = "🔒 Ставки закрыты — идёт раунд. Жди перерыва!"
		end
		local jackpot = state:GetAttribute("Jackpot") or 0
		bank.Text = string.format(
			"Банк ставок: %s 💰 (+25%%) • Джекпот: %s 💰",
			Config.Format(total),
			Config.Format(jackpot)
		)
	end

	hud.RegisterPanel("Bets", frame, close, function()
		rebuild()
		refreshInfo()
	end)
	hud.AddMenuButton("bets", "🎲", "Ставки", Color3.fromRGB(255, 160, 40), 1, function()
		hud.OpenPanel("Bets")
	end)

	Net.Event("BetUpdate").OnClientEvent:Connect(function(newPools, newMine, newTotal)
		pools = newPools or {}
		mine = newMine or {}
		total = newTotal or 0
		if frame.Visible then
			rebuild()
		end
	end)
	Players.PlayerAdded:Connect(function()
		if frame.Visible then
			rebuild()
		end
	end)
	Players.PlayerRemoving:Connect(function()
		task.defer(function()
			if frame.Visible then
				rebuild()
			end
		end)
	end)
	task.spawn(function()
		while true do
			if frame.Visible then
				refreshInfo()
			end
			task.wait(0.25)
		end
	end)
	-- автоматически подсказываем про ставки в начале перерыва
	state:GetAttributeChangedSignal("BetsOpen"):Connect(function()
		if frame.Visible then
			rebuild()
		end
	end)
end

return Bets
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">Duel</string>
              <string name="Source"><![CDATA[-- Дуэли в монетку: вызов, приглашение и анимация броска.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Sounds = require(script.Parent.Parent.Sounds)
local UI = require(script.Parent.Parent.UI)

local player = Players.LocalPlayer

local Duel = {}

local HEADS = "👑"
local TAILS = "🌙"

function Duel.Init(hud)
	local gui = hud.Gui()
	local accent = Color3.fromRGB(60, 200, 255)
	local frame, content, close = UI.Panel(gui, "🪙 ДУЭЛЬ В МОНЕТКУ", UDim2.fromOffset(500, 500), accent)

	UI.Label({
		Size = UDim2.new(1, 0, 0, 40),
		Text = "Оба ставят одинаково. Победитель забирает всё!\nТы — " .. HEADS .. ", соперник — " .. TAILS,
		TextColor3 = UI.Colors.Muted,
		Font = UI.Font,
		ZIndex = 6,
		Parent = content,
	})
	local amountHolder = UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 80),
		Position = UDim2.fromOffset(0, 46),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = content,
	})
	local amount = UI.AmountSelector(amountHolder, 100)
	local list = UI.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -136),
		Position = UDim2.fromOffset(0, 134),
		BackgroundColor3 = UI.Colors.Panel,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 5,
		Parent = content,
	}, {
		UI.Corner(10),
		UI.Padding(6),
		UI.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local function rebuild()
		for _, child in list:GetChildren() do
			if child:IsA("Frame") or child:IsA("TextLabel") then
				child:Destroy()
			end
		end
		local count = 0
		for _, target in Players:GetPlayers() do
			if target ~= player then
				count += 1
				local row = UI.new("Frame", {
					Size = UDim2.new(1, -4, 0, 48),
					BackgroundColor3 = UI.Colors.Panel2,
					LayoutOrder = count,
					ZIndex = 6,
					Parent = list,
				}, {
					UI.Corner(10),
				})
				UI.Label({
					Text = string.format(
						'%s  <font color="#FFC83C">💰 %s</font>',
						target.DisplayName,
						Config.Format(target:GetAttribute("Coins") or 0)
					),
					Size = UDim2.new(1, -150, 0, 28),
					Position = UDim2.fromOffset(10, 10),
					TextXAlignment = Enum.TextXAlignment.Left,
					Font = UI.FontBlack,
					ZIndex = 7,
					Parent = row,
				})
				local button = UI.Button("⚔️ Вызвать", accent, {
					Size = UDim2.fromOffset(130, 38),
					Position = UDim2.new(1, -136, 0, 5),
					ZIndex = 7,
					Parent = row,
				})
				button.Activated:Connect(function()
					Net.Event("DuelRequest"):FireServer(target.UserId, amount.Get())
				end)
			end
		end
		if count == 0 then
			UI.Label({
				Text = "Пока никого нет... Позови друзей! 👥",
				Size = UDim2.new(1, -4, 0, 40),
				TextColor3 = UI.Colors.Muted,
				ZIndex = 6,
				Parent = list,
			})
		end
	end

	hud.RegisterPanel("Duel", frame, close, rebuild)
	hud.AddMenuButton("duel", "🪙", "Дуэль", accent, 3, function()
		hud.OpenPanel("Duel")
	end)
	Players.PlayerAdded:Connect(function()
		if frame.Visible then
			rebuild()
		end
	end)
	Players.PlayerRemoving:Connect(function()
		task.defer(function()
			if frame.Visible then
				rebuild()
			end
		end)
	end)

	------------------------------------------------------------------
	-- Приглашение
	------------------------------------------------------------------
	local invite = UI.new("Frame", {
		Name = "DuelInvite",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -146),
		Size = UDim2.fromOffset(440, 124),
		BackgroundColor3 = UI.Colors.Bg,
		Visible = false,
		ZIndex = 8,
		Parent = gui,
	}, {
		UI.Corner(14),
		UI.Stroke(accent, 3),
		UI.new("UIScale"),
	})
	local inviteText = UI.Label({
		Size = UDim2.new(1, -20, 0, 50),
		Position = UDim2.fromOffset(10, 6),
		Font = UI.FontBlack,
		ZIndex = 9,
		Parent = invite,
	})
	local accept = UI.Button("✅ Принять", UI.Colors.Good, {
		Size = UDim2.new(0.5, -15, 0, 42),
		Position = UDim2.fromOffset(10, 62),
		ZIndex = 9,
		Parent = invite,
	})
	local decline = UI.Button("❌ Отказ", UI.Colors.Bad, {
		Size = UDim2.new(0.5, -15, 0, 42),
		Position = UDim2.new(0.5, 5, 0, 62),
		ZIndex = 9,
		Parent = invite,
	})
	local timerBar = UI.new("Frame", {
		Size = UDim2.new(1, -20, 0, 6),
		Position = UDim2.new(0, 10, 1, -12),
		BackgroundColor3 = accent,
		BorderSizePixel = 0,
		ZIndex = 9,
		Parent = invite,
	}, {
		UI.Corner(3),
	})
	local currentInvite: string? = nil
	local function respond(ok: boolean)
		if currentInvite then
			Net.Event("DuelRespond"):FireServer(currentInvite, ok)
		end
		currentInvite = nil
		invite.Visible = false
	end
	accept.Activated:Connect(function()
		respond(true)
	end)
	decline.Activated:Connect(function()
		respond(false)
	end)
	Net.Event("DuelInvite").OnClientEvent:Connect(function(id: string, fromName: string, bet: number, timeout: number)
		currentInvite = id
		inviteText.Text = string.format("⚔️ %s вызывает тебя на монетку!\nСтавка: %s 💰", fromName, Config.Format(bet))
		invite.Visible = true
		timerBar.Size = UDim2.new(1, -20, 0, 6)
		UI.Tween(timerBar, timeout, { Size = UDim2.new(0, 0, 0, 6) }, Enum.EasingStyle.Linear)
		Sounds.Play("Win", 0.5, 0.8)
		task.delay(timeout, function()
			if currentInvite == id then
				currentInvite = nil
				invite.Visible = false
			end
		end)
	end)

	------------------------------------------------------------------
	-- Бросок монетки
	------------------------------------------------------------------
	local flip = UI.new("Frame", {
		Name = "CoinFlip",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(420, 300),
		BackgroundColor3 = UI.Colors.Bg,
		BackgroundTransparency = 0.05,
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	}, {
		UI.Corner(18),
		UI.Stroke(UI.Colors.Accent, 3),
		UI.new("UIScale"),
	})
	local vsLabel = UI.Label({
		Size = UDim2.new(1, -20, 0, 40),
		Position = UDim2.fromOffset(10, 10),
		Font = UI.FontBlack,
		ZIndex = 11,
		Parent = flip,
	})
	local coin = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(130, 130),
		BackgroundColor3 = Color3.fromRGB(255, 200, 50),
		ZIndex = 11,
		Parent = flip,
	}, {
		UI.new("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
		UI.Stroke(Color3.fromRGB(170, 110, 0), 5),
		UI.Gradient(Color3.fromRGB(255, 230, 120), Color3.fromRGB(230, 150, 0)),
	})
	local face = UI.Label({
		Size = UDim2.fromScale(0.7, 0.7),
		Position = UDim2.fromScale(0.15, 0.15),
		Text = HEADS,
		ZIndex = 12,
		Parent = coin,
	})
	local resultLabel = UI.Label({
		Size = UDim2.new(1, -20, 0, 44),
		Position = UDim2.new(0, 10, 1, -54),
		Font = UI.FontBlack,
		Text = "",
		ZIndex = 11,
		Parent = flip,
	})
	UI.TextStroke(2).Parent = resultLabel

	Net.Event("DuelResult").OnClientEvent:Connect(function(data)
		hud.ClosePanel()
		flip.Visible = true
		resultLabel.Text = ""
		vsLabel.Text = string.format("%s %s  🆚  %s %s", HEADS, data.Challenger, data.Opponent, TAILS)
		local finalFace = data.ChallengerWins and HEADS or TAILS
		local duration = (data.FlipTime or 3) - 0.6
		local started = os.clock()
		local spins = 0
		while os.clock() - started < duration do
			local t = (os.clock() - started) / duration
			local speed = 0.04 + t * t * 0.18
			UI.Tween(coin, speed, { Size = UDim2.fromOffset(8, 130) })
			task.wait(speed)
			spins += 1
			face.Text = spins % 2 == 0 and HEADS or TAILS
			UI.Tween(coin, speed, { Size = UDim2.fromOffset(130, 130) })
			task.wait(speed)
			Sounds.Play("Tick", 0.25, 1.5)
		end
		face.Text = finalFace
		coin.Size = UDim2.fromOffset(130, 130)
		if data.YouWon then
			resultLabel.Text = string.format("🏆 ТЫ ВЫИГРАЛ %s 💰!", Config.Format(data.Amount * 2))
			resultLabel.TextColor3 = UI.Colors.Good
			Sounds.Play("Win", 0.6)
		else
			resultLabel.Text = string.format("😭 Победил %s", data.Winner)
			resultLabel.TextColor3 = UI.Colors.Bad
			Sounds.Play("Lose", 0.5)
		end
		task.wait(2.6)
		flip.Visible = false
	end)

	-- общий масштаб для всплывающих окон
	local function syncScales()
		local panelScale = frame:FindFirstChildOfClass("UIScale")
		local value = panelScale and panelScale.Scale or 1
		for _, popup in { invite, flip } do
			local scale = popup:FindFirstChildOfClass("UIScale")
			if scale then
				scale.Scale = value
			end
		end
	end
	local panelScale = frame:FindFirstChildOfClass("UIScale")
	if panelScale then
		panelScale:GetPropertyChangedSignal("Scale"):Connect(syncScales)
	end
	syncScales()
end

return Duel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">Roulette</string>
              <string name="Source"><![CDATA[-- Панель рулетки: ставки на цвет, история, мини-табло вращения.

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Sounds = require(script.Parent.Parent.Sounds)
local UI = require(script.Parent.Parent.UI)

local state = Net.State()
local RC = Config.Roulette

local Roulette = {}

function Roulette.Init(hud)
	local accent = Color3.fromRGB(220, 40, 60)
	local frame, content, close = UI.Panel(hud.Gui(), "🎡 РУЛЕТКА", UDim2.fromOffset(540, 560), accent)

	local timer = UI.Label({
		Size = UDim2.new(1, 0, 0, 28),
		Font = UI.FontBlack,
		TextColor3 = UI.Colors.Accent,
		ZIndex = 6,
		Parent = content,
	})

	local historyRow = UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 26),
		Position = UDim2.fromOffset(0, 32),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = content,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 5),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local display = UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 86),
		Position = UDim2.fromOffset(0, 64),
		BackgroundColor3 = RC.Colors.green.Color,
		ZIndex = 6,
		Parent = content,
	}, {
		UI.Corner(14),
		UI.Stroke(UI.Colors.Accent, 3),
	})
	local displayLabel = UI.Label({
		Size = UDim2.new(1, -20, 1, -16),
		Position = UDim2.fromOffset(10, 8),
		Font = UI.FontBlack,
		Text = "Делай ставку!",
		ZIndex = 7,
		Parent = display,
	})
	UI.TextStroke(3).Parent = displayLabel

	local amountHolder = UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 80),
		Position = UDim2.fromOffset(0, 160),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = content,
	})
	local amount = UI.AmountSelector(amountHolder, 50)

	local buttonsRow = UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 150),
		Position = UDim2.fromOffset(0, 250),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = content,
	}, {
		UI.new("UIGridLayout", {
			CellSize = UDim2.new(1 / 3, -8, 1, 0),
			CellPadding = UDim2.fromOffset(10, 0),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local totalLabels: { [string]: TextLabel } = {}
	local mineLabels: { [string]: TextLabel } = {}
	for i, colorId in RC.ColorOrder do
		local info = RC.Colors[colorId]
		local button = UI.Button("", colorId == "black" and Color3.fromRGB(45, 45, 55) or info.Color, {
			LayoutOrder = i,
			ZIndex = 6,
			Parent = buttonsRow,
		})
		UI.Label({
			Text = string.format("%s %s", info.Icon, info.Name),
			Size = UDim2.new(1, 0, 0.3, 0),
			Font = UI.FontBlack,
			ZIndex = 7,
			Parent = button,
		})
		UI.Label({
			Text = "x" .. info.Multiplier,
			Size = UDim2.new(1, 0, 0.26, 0),
			Position = UDim2.fromScale(0, 0.3),
			Font = UI.FontBlack,
			TextColor3 = UI.Colors.Accent,
			ZIndex = 7,
			Parent = button,
		})
		totalLabels[colorId] = UI.Label({
			Text = "Всего: 0",
			Size = UDim2.new(1, 0, 0.18, 0),
			Position = UDim2.fromScale(0, 0.6),
			TextColor3 = Color3.fromRGB(230, 230, 240),
			ZIndex = 7,
			Parent = button,
		})
		mineLabels[colorId] = UI.Label({
			Text = "Твоя: 0",
			Size = UDim2.new(1, 0, 0.18, 0),
			Position = UDim2.fromScale(0, 0.8),
			TextColor3 = UI.Colors.Accent,
			ZIndex = 7,
			Parent = button,
		})
		button.Activated:Connect(function()
			Net.Event("RouletteBet"):FireServer(colorId, amount.Get())
			Sounds.Play("Click", 0.4, 1.4)
		end)
	end

	UI.Label({
		Size = UDim2.new(1, 0, 0, 36),
		Position = UDim2.new(0, 0, 1, -38),
		Text = "Колесо стоит в лобби слева от спавна. Ставки принимаются, пока идёт отсчёт.",
		TextColor3 = UI.Colors.Muted,
		Font = UI.Font,
		TextWrapped = true,
		ZIndex = 6,
		Parent = content,
	})

	local function refreshHistory()
		for _, child in historyRow:GetChildren() do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		local raw = tostring(state:GetAttribute("RouletteHistory") or "")
		local i = 0
		for colorId in string.gmatch(raw, "[^,]+") do
			local info = RC.Colors[colorId]
			if info then
				i += 1
				UI.new("Frame", {
					Size = UDim2.fromOffset(22, 22),
					BackgroundColor3 = info.Color,
					LayoutOrder = i,
					ZIndex = 7,
					Parent = historyRow,
				}, {
					UI.Corner(11),
					UI.Stroke(i == 1 and UI.Colors.Accent or Color3.new(1, 1, 1), i == 1 and 2.5 or 1),
				})
			end
		end
	end

	local function refreshTotals()
		local ok, totals = pcall(function()
			return HttpService:JSONDecode(tostring(state:GetAttribute("RouletteTotals") or "{}"))
		end)
		if not ok or type(totals) ~= "table" then
			return
		end
		for colorId, label in totalLabels do
			label.Text = "Всего: " .. Config.Format(totals[colorId] or 0)
		end
	end

	local spinning = false
	task.spawn(function()
		while true do
			local phase = state:GetAttribute("RoulettePhase")
			local left = math.max(0, math.ceil((state:GetAttribute("RouletteEndsAt") or 0) - Net.Now()))
			if phase == "Betting" then
				timer.Text = string.format("⏳ Приём ставок: %d с", left)
				if not spinning then
					displayLabel.Text = "Делай ставку!"
				end
			elseif phase == "Spinning" then
				timer.Text = "🎡 Крутим..."
			else
				timer.Text = "Новый круг через " .. left .. " с"
			end
			task.wait(0.2)
		end
	end)

	Net.Event("RouletteSpin").OnClientEvent:Connect(function(index: number, _offset: number, resultColor: string, spinTime: number)
		spinning = true
		local segments = RC.Segments
		local count = #segments
		local start = math.random(count)
		local steps = count * 3 + ((index - start) % count)
		local duration = math.max(1, spinTime - 0.9)
		local base = 0.03
		local weights = 0
		for i = 1, steps do
			weights += (i / steps) ^ 2
		end
		local k = math.max(0, (duration - steps * base) / weights)
		task.spawn(function()
			for i = 1, steps do
				local seg = segments[(start + i - 1) % count + 1]
				display.BackgroundColor3 = seg == "black" and Color3.fromRGB(45, 45, 55) or RC.Colors[seg].Color
				displayLabel.Text = RC.Colors[seg].Icon
				task.wait(base + k * (i / steps) ^ 2)
			end
			local info = RC.Colors[resultColor]
			display.BackgroundColor3 = resultColor == "black" and Color3.fromRGB(45, 45, 55) or info.Color
			displayLabel.Text = string.format("%s %s!", info.Icon, info.Name)
			task.wait(3)
			spinning = false
		end)
	end)

	Net.Event("RouletteMyBets").OnClientEvent:Connect(function(bets)
		for colorId, label in mineLabels do
			label.Text = "Твоя: " .. Config.Format((bets and bets[colorId]) or 0)
		end
	end)

	state:GetAttributeChangedSignal("RouletteHistory"):Connect(refreshHistory)
	state:GetAttributeChangedSignal("RouletteTotals"):Connect(refreshTotals)
	refreshHistory()
	refreshTotals()

	hud.RegisterPanel("Roulette", frame, close)
	hud.AddMenuButton("roulette", "🎡", "Рулетка", Color3.fromRGB(255, 80, 90), 2, function()
		hud.OpenPanel("Roulette")
	end)
end

return Roulette
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[-- Магазин следов.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local UI = require(script.Parent.Parent.UI)

local player = Players.LocalPlayer

local Shop = {}

local owned: { [string]: boolean } = {}
local equipped = ""

function Shop.Init(hud)
	local accent = Color3.fromRGB(180, 80, 255)
	local frame, content, close = UI.Panel(hud.Gui(), "🛒 МАГАЗИН СЛЕДОВ", UDim2.fromOffset(520, 540), accent)

	local list = UI.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -50),
		BackgroundColor3 = UI.Colors.Panel,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 5,
		Parent = content,
	}, {
		UI.Corner(10),
		UI.Padding(6),
		UI.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local unequip = UI.Button("Снять след", UI.Colors.Panel2, {
		Size = UDim2.new(1, 0, 0, 40),
		Position = UDim2.new(0, 0, 1, -42),
		ZIndex = 6,
		Parent = content,
	})
	unequip.Activated:Connect(function()
		Net.Event("ShopAction"):FireServer("equip", "")
	end)

	local function rebuild()
		for _, child in list:GetChildren() do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		local coins = player:GetAttribute("Coins") or 0
		for i, item in Config.Trails do
			local row = UI.new("Frame", {
				Size = UDim2.new(1, -4, 0, 62),
				BackgroundColor3 = UI.Colors.Panel2,
				LayoutOrder = i,
				ZIndex = 6,
				Parent = list,
			}, {
				UI.Corner(10),
			})
			UI.new("Frame", {
				Size = UDim2.fromOffset(84, 44),
				Position = UDim2.fromOffset(9, 9),
				BackgroundColor3 = Color3.new(1, 1, 1),
				ZIndex = 7,
				Parent = row,
			}, {
				UI.Corner(10),
				UI.new("UIGradient", { Color = Config.ColorSequenceFrom(item.Colors) }),
			})
			UI.Label({
				Text = item.Name .. " след" .. (item.Sparkles and " ✨" or ""),
				Size = UDim2.new(1, -250, 0, 26),
				Position = UDim2.fromOffset(104, 6),
				TextXAlignment = Enum.TextXAlignment.Left,
				Font = UI.FontBlack,
				ZIndex = 7,
				Parent = row,
			})
			UI.Label({
				Text = "💰 " .. Config.Format(item.Price),
				Size = UDim2.new(1, -250, 0, 20),
				Position = UDim2.fromOffset(104, 34),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = UI.Colors.Accent,
				ZIndex = 7,
				Parent = row,
			})
			local text, color, action
			if equipped == item.Id then
				text, color, action = "✔ Надет", UI.Colors.Panel, nil
			elseif owned[item.Id] then
				text, color, action = "Надеть", UI.Colors.Cyan, "equip"
			elseif coins >= item.Price then
				text, color, action = "Купить", UI.Colors.Good, "buy"
			else
				text, color, action = "Мало 💰", UI.Colors.Bad, "buy"
			end
			local button = UI.Button(text, color, {
				Size = UDim2.fromOffset(130, 42),
				Position = UDim2.new(1, -138, 0, 10),
				ZIndex = 7,
				Parent = row,
			})
			button.Activated:Connect(function()
				if action then
					Net.Event("ShopAction"):FireServer(action, item.Id)
				end
			end)
		end
	end

	Net.Event("ShopState").OnClientEvent:Connect(function(ownedList, newEquipped)
		owned = {}
		for _, id in ownedList or {} do
			owned[id] = true
		end
		equipped = newEquipped or ""
		if frame.Visible then
			rebuild()
		end
	end)
	player:GetAttributeChangedSignal("Coins"):Connect(function()
		if frame.Visible then
			rebuild()
		end
	end)

	hud.RegisterPanel("Shop", frame, close, rebuild)
	hud.AddMenuButton("shop", "🛒", "Магазин", accent, 4, function()
		hud.OpenPanel("Shop")
	end)
end

return Shop
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">SlotsView</string>
            <string name="Source"><![CDATA[-- Анимация барабанов слотов на экране игрока.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Sounds = require(script.Parent.Sounds)
local UI = require(script.Parent.UI)

local SlotsView = {}

local SYMBOLS = Config.Slots.Symbols

local function machineName(id: number): string
	for _, machine in Config.Slots.Machines do
		if machine.Id == id then
			return machine.Name
		end
	end
	return ""
end

function SlotsView.Init(hud)
	local frame = UI.new("Frame", {
		Name = "Slots",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(380, 190),
		BackgroundColor3 = UI.Colors.Bg,
		BackgroundTransparency = 0.05,
		Visible = false,
		ZIndex = 4,
		Parent = hud.Gui(),
	}, {
		UI.Corner(16),
		UI.Stroke(UI.Colors.Accent, 3),
		UI.new("UIScale"),
	})
	local title = UI.Label({
		Size = UDim2.new(1, -20, 0, 26),
		Position = UDim2.fromOffset(10, 6),
		Font = UI.FontBlack,
		TextColor3 = UI.Colors.Accent,
		ZIndex = 5,
		Parent = frame,
	})
	local reels: { TextLabel } = {}
	for i = 1, 3 do
		local box = UI.new("Frame", {
			Size = UDim2.fromOffset(100, 100),
			Position = UDim2.fromOffset(25 + (i - 1) * 115, 38),
			BackgroundColor3 = Color3.fromRGB(250, 245, 255),
			ZIndex = 5,
			Parent = frame,
		}, {
			UI.Corner(12),
			UI.Stroke(UI.Colors.Pink, 3),
		})
		reels[i] = UI.Label({
			Size = UDim2.fromScale(0.8, 0.8),
			Position = UDim2.fromScale(0.1, 0.1),
			Text = SYMBOLS[i].Icon,
			ZIndex = 6,
			Parent = box,
		})
	end
	local result = UI.Label({
		Size = UDim2.new(1, -20, 0, 36),
		Position = UDim2.new(0, 10, 1, -44),
		Font = UI.FontBlack,
		Text = "",
		ZIndex = 5,
		Parent = frame,
	})
	UI.TextStroke(2).Parent = result

	-- масштаб как у панелей
	task.defer(function()
		local scale = frame:FindFirstChildOfClass("UIScale")
		local status = hud.Gui():FindFirstChild("Status")
		local source = status and status:FindFirstChildOfClass("UIScale")
		if scale and source then
			scale.Scale = source.Scale
			source:GetPropertyChangedSignal("Scale"):Connect(function()
				scale.Scale = source.Scale
			end)
		end
	end)

	local token = 0
	Net.Event("SlotResult").OnClientEvent:Connect(function(machineId: number, icons: { string }, payout: number, stake: number, multiplier: number)
		token += 1
		local myToken = token
		frame.Visible = true
		title.Text = string.format("🎰 %s • ставка %s 💰", machineName(machineId), Config.Format(stake))
		result.Text = "Крутим..."
		result.TextColor3 = UI.Colors.Text
		local spinTime = Config.Slots.SpinTime - 0.1
		local stops = { spinTime * 0.45, spinTime * 0.7, spinTime }
		local started = os.clock()
		local stopped = { false, false, false }
		while os.clock() - started < spinTime do
			local elapsed = os.clock() - started
			for i = 1, 3 do
				if not stopped[i] then
					if elapsed >= stops[i] then
						stopped[i] = true
						reels[i].Text = icons[i]
						Sounds.Play("Click", 0.5, 0.8)
					else
						reels[i].Text = SYMBOLS[math.random(#SYMBOLS)].Icon
					end
				end
			end
			Sounds.Play("Tick", 0.15, 1.8)
			task.wait(0.07)
		end
		for i = 1, 3 do
			reels[i].Text = icons[i]
		end
		if payout > stake then
			result.Text = string.format("🎉 x%d! +%s 💰", multiplier, Config.Format(payout))
			result.TextColor3 = UI.Colors.Good
			Sounds.Play("Win", 0.6)
			if multiplier >= Config.Slots.BigWinMultiplier then
				hud.Announce(string.format("💥 ДЖЕКПОТ x%d!", multiplier), UI.Colors.Accent, 2.5)
			end
		elseif payout == stake then
			result.Text = "↩️ Возврат ставки"
			result.TextColor3 = UI.Colors.Cyan
		else
			result.Text = "Мимо... ещё разок? 😈"
			result.TextColor3 = UI.Colors.Bad
		end
		task.delay(3, function()
			if token == myToken then
				frame.Visible = false
			end
		end)
	end)
end

return SlotsView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Sounds</string>
            <string name="Source"><![CDATA[-- Звуки интерфейса. Используются встроенные файлы клиента Roblox (rbxasset://),
-- поэтому ничего не нужно загружать. Свои звуки можно вписать сюда (rbxassetid://ID).

local Debris = game:GetService("Debris")
local SoundService = game:GetService("SoundService")

local Sounds = {}

local IDS = {
	Click = "rbxasset://sounds/clickfast.wav",
	Tick = "rbxasset://sounds/clickfast.wav",
	Win = "rbxasset://sounds/electronicpingshort.wav",
	Coin = "rbxasset://sounds/electronicpingshort.wav",
	Lose = "rbxasset://sounds/swoosh.wav",
	Whoosh = "rbxasset://sounds/swoosh.wav",
}

function Sounds.Play(name: string, volume: number?, speed: number?)
	local id = IDS[name]
	if not id then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or 0.5
	sound.PlaybackSpeed = speed or 1
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, 3)
end

return Sounds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Spectate</string>
            <string name="Source"><![CDATA[-- Режим зрителя: смотри за теми, кто ещё в игре (и за кем стоят твои ставки).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Net = require(ReplicatedStorage.Shared.Net)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local state = Net.State()

local Spectate = {}

function Spectate.Init(hud)
	local spectating = false
	local index = 1

	local bar = UI.new("Frame", {
		Name = "Spectate",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -84),
		Size = UDim2.fromOffset(440, 54),
		BackgroundColor3 = UI.Colors.Bg,
		BackgroundTransparency = 0.05,
		Visible = false,
		ZIndex = 4,
		Parent = hud.Gui(),
	}, {
		UI.Corner(14),
		UI.Stroke(UI.Colors.Cyan, 2.5),
		UI.new("UIScale"),
	})
	local prev = UI.Button("◀", UI.Colors.Panel2, {
		Size = UDim2.fromOffset(46, 42),
		Position = UDim2.fromOffset(6, 6),
		ZIndex = 5,
		Parent = bar,
	})
	local nameLabel = UI.Label({
		Size = UDim2.new(1, -170, 0, 42),
		Position = UDim2.fromOffset(58, 6),
		Font = UI.FontBlack,
		Text = "",
		ZIndex = 5,
		Parent = bar,
	})
	local nextButton = UI.Button("▶", UI.Colors.Panel2, {
		Size = UDim2.fromOffset(46, 42),
		Position = UDim2.new(1, -106, 0, 6),
		ZIndex = 5,
		Parent = bar,
	})
	local exit = UI.Button("✕", UI.Colors.Bad, {
		Size = UDim2.fromOffset(46, 42),
		Position = UDim2.new(1, -54, 0, 6),
		ZIndex = 5,
		Parent = bar,
	})

	local function candidates(): { Player }
		local list = {}
		for _, other in Players:GetPlayers() do
			if other ~= player and other:GetAttribute("InRound") == true then
				table.insert(list, other)
			end
		end
		return list
	end

	local function ownHumanoid(): Humanoid?
		local character = player.Character
		return character and character:FindFirstChildOfClass("Humanoid")
	end

	local function stop()
		spectating = false
		bar.Visible = false
		local camera = Workspace.CurrentCamera
		local humanoid = ownHumanoid()
		if camera and humanoid then
			camera.CameraSubject = humanoid
		end
	end

	local function show()
		local list = candidates()
		if #list == 0 then
			stop()
			return
		end
		index = (index - 1) % #list + 1
		local target = list[index]
		local character = target.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local camera = Workspace.CurrentCamera
		if humanoid and camera then
			camera.CameraSubject = humanoid
			nameLabel.Text = "👁 " .. target.DisplayName
		end
	end

	local button = hud.AddMenuButton("spectate", "👁", "Смотреть", UI.Colors.Cyan, 5, function()
		if spectating then
			stop()
		else
			spectating = true
			bar.Visible = true
			hud.ClosePanel()
			show()
		end
	end)
	button.Visible = false

	prev.Activated:Connect(function()
		index -= 1
		show()
	end)
	nextButton.Activated:Connect(function()
		index += 1
		show()
	end)
	exit.Activated:Connect(stop)

	player.CharacterAdded:Connect(function()
		if spectating then
			task.wait(0.3)
			show()
		end
	end)

	task.defer(function()
		local scale = bar:FindFirstChildOfClass("UIScale")
		local status = hud.Gui():FindFirstChild("Status")
		local source = status and status:FindFirstChildOfClass("UIScale")
		if scale and source then
			scale.Scale = source.Scale
			source:GetPropertyChangedSignal("Scale"):Connect(function()
				scale.Scale = source.Scale
			end)
		end
	end)

	task.spawn(function()
		while true do
			local canWatch = state:GetAttribute("Phase") == "Playing" and player:GetAttribute("InRound") ~= true
			button.Visible = canWatch
			if spectating then
				if not canWatch then
					stop()
				else
					local camera = Workspace.CurrentCamera
					local subject = camera and camera.CameraSubject
					local list = candidates()
					local watchingValid = false
					for _, other in list do
						local character = other.Character
						if subject and character and subject:IsDescendantOf(character) then
							watchingValid = true
						end
					end
					if not watchingValid then
						show()
					end
				end
			end
			task.wait(0.4)
		end
	end)
end

return Spectate
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[-- Помощники для построения интерфейса из кода.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local UI = {}

UI.Colors = {
	Bg = Color3.fromRGB(20, 16, 34),
	Panel = Color3.fromRGB(32, 26, 54),
	Panel2 = Color3.fromRGB(46, 38, 76),
	Accent = Color3.fromRGB(255, 196, 40),
	Pink = Color3.fromRGB(255, 60, 170),
	Cyan = Color3.fromRGB(40, 220, 255),
	Text = Color3.fromRGB(245, 240, 255),
	Muted = Color3.fromRGB(170, 160, 205),
	Good = Color3.fromRGB(60, 220, 110),
	Bad = Color3.fromRGB(255, 70, 85),
}

UI.Font = Enum.Font.GothamBold
UI.FontBlack = Enum.Font.GothamBlack

function UI.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	if props then
		for key, value in props do
			if key ~= "Parent" then
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function UI.Corner(radius: number?): UICorner
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function UI.Stroke(color: Color3?, thickness: number?, transparency: number?): UIStroke
	return UI.new("UIStroke", {
		Color = color or Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.TextStroke(thickness: number?): UIStroke
	return UI.new("UIStroke", {
		Color = Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		Transparency = 0.3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	})
end

function UI.Padding(px: number): UIPadding
	return UI.new("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
	})
end

function UI.List(padding: number?, horizontal: boolean?, align: Enum.HorizontalAlignment?): UIListLayout
	return UI.new("UIListLayout", {
		Padding = UDim.new(0, padding or 6),
		FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function UI.Gradient(a: Color3, b: Color3, rotation: number?): UIGradient
	return UI.new("UIGradient", {
		Color = ColorSequence.new(a, b),
		Rotation = rotation or 90,
	})
end

function UI.Label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = UI.Font,
		TextColor3 = UI.Colors.Text,
		TextScaled = true,
		RichText = true,
	}
	for key, value in props do
		defaults[key] = value
	end
	return UI.new("TextLabel", defaults)
end

function UI.Button(text: string, color: Color3, props: { [string]: any }?): TextButton
	local base = {
		Text = text,
		BackgroundColor3 = color,
		TextColor3 = Color3.new(1, 1, 1),
		Font = UI.FontBlack,
		TextScaled = true,
		AutoButtonColor = true,
		RichText = true,
	}
	if props then
		for key, value in props do
			base[key] = value
		end
	end
	local button = UI.new("TextButton", base, {
		UI.Corner(10),
		UI.Stroke(color:Lerp(Color3.new(0, 0, 0), 0.45), 2),
		UI.new("UIPadding", {
			PaddingTop = UDim.new(0, 5),
			PaddingBottom = UDim.new(0, 5),
			PaddingLeft = UDim.new(0, 6),
			PaddingRight = UDim.new(0, 6),
		}),
		UI.TextStroke(1.5),
	})
	return button
end

function UI.Tween(inst: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): Tween
	local tween = TweenService:Create(
		inst,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		props
	)
	tween:Play()
	return tween
end

-- Модальная панель с заголовком и кнопкой закрытия.
function UI.Panel(parent: Instance, title: string, size: UDim2, accent: Color3)
	local frame = UI.new("Frame", {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = size,
		BackgroundColor3 = UI.Colors.Bg,
		Visible = false,
		ZIndex = 5,
		Parent = parent,
	}, {
		UI.Corner(16),
		UI.Stroke(accent, 3),
	})
	local header = UI.new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 50),
		BackgroundColor3 = accent,
		ZIndex = 5,
		Parent = frame,
	}, {
		UI.Corner(16),
		UI.Gradient(accent, accent:Lerp(Color3.new(0, 0, 0), 0.35)),
	})
	-- закрываем нижние скруглённые углы шапки
	UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 16),
		Position = UDim2.new(0, 0, 1, -16),
		BackgroundColor3 = accent:Lerp(Color3.new(0, 0, 0), 0.35),
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = header,
	})
	UI.Label({
		Text = title,
		Size = UDim2.new(1, -70, 1, -14),
		Position = UDim2.fromOffset(16, 7),
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = UI.FontBlack,
		ZIndex = 6,
		Parent = header,
	})
	local close = UI.Button("✕", UI.Colors.Bad, {
		Size = UDim2.fromOffset(38, 38),
		Position = UDim2.new(1, -46, 0, 6),
		ZIndex = 7,
		Parent = header,
	})
	local content = UI.new("Frame", {
		Name = "Content",
		Size = UDim2.new(1, -24, 1, -66),
		Position = UDim2.fromOffset(12, 58),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = frame,
	})
	return frame, content, close
end

-- Поле ввода суммы с быстрыми кнопками.
function UI.AmountSelector(parent: Instance, default: number, layoutOrder: number?)
	local player = Players.LocalPlayer
	local holder = UI.new("Frame", {
		Name = "Amount",
		Size = UDim2.new(1, 0, 0, 80),
		BackgroundTransparency = 1,
		LayoutOrder = layoutOrder or 0,
		ZIndex = 5,
		Parent = parent,
	})
	UI.Label({
		Text = "Ставка:",
		Size = UDim2.new(0, 80, 0, 34),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = UI.Colors.Muted,
		ZIndex = 6,
		Parent = holder,
	})
	local box = UI.new("TextBox", {
		Size = UDim2.new(1, -90, 0, 34),
		Position = UDim2.fromOffset(86, 0),
		BackgroundColor3 = UI.Colors.Panel2,
		Text = tostring(default),
		PlaceholderText = "сумма",
		ClearTextOnFocus = false,
		TextColor3 = UI.Colors.Accent,
		Font = UI.FontBlack,
		TextScaled = true,
		ZIndex = 6,
		Parent = holder,
	}, {
		UI.Corner(8),
		UI.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) }),
	})
	local chips = UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 36),
		Position = UDim2.fromOffset(0, 42),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = holder,
	}, {
		UI.new("UIGridLayout", {
			CellSize = UDim2.new(1 / 7, -5, 1, 0),
			CellPadding = UDim2.fromOffset(5, 0),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local function get(): number
		local digits = string.gsub(box.Text, "%D", "")
		return tonumber(digits) or 0
	end
	local function set(value: number)
		box.Text = tostring(math.max(0, math.floor(value)))
	end
	box.FocusLost:Connect(function()
		set(get())
	end)

	local function coins(): number
		return player:GetAttribute("Coins") or 0
	end
	local chipDefs = {
		{ "10", function() set(10) end },
		{ "100", function() set(100) end },
		{ "1K", function() set(1000) end },
		{ "10K", function() set(10000) end },
		{ "½", function() set(get() / 2) end },
		{ "x2", function() set(get() * 2) end },
		{ "ВСЁ", function() set(coins()) end },
	}
	for i, def in chipDefs do
		local chip = UI.Button(def[1], i == #chipDefs and UI.Colors.Pink or UI.Colors.Panel2, {
			LayoutOrder = i,
			ZIndex = 7,
			Parent = chips,
		})
		chip.Activated:Connect(def[2])
	end

	return {
		Frame = holder,
		Get = get,
		Set = set,
	}
end

return UI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">WheelView</string>
            <string name="Source"><![CDATA[-- Плавное вращение колеса рулетки и декоративных деталей (делается на клиенте).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Net = require(ReplicatedStorage.Shared.Net)
local Sounds = require(script.Parent.Sounds)

local WheelView = {}

local TAU = math.pi * 2

local function setupWheel()
	local lobby = Workspace:WaitForChild("Lobby")
	local rouletteFolder = lobby:WaitForChild("Roulette")
	local wheel = rouletteFolder:WaitForChild("Wheel")
	local base = wheel:GetAttribute("Base")
	local count = wheel:GetAttribute("Segments")
	if typeof(base) ~= "CFrame" or type(count) ~= "number" then
		return
	end
	local segAngle = TAU / count

	local offsets: { [BasePart]: CFrame } = {}
	local function collect()
		for _, part in wheel:GetDescendants() do
			if part:IsA("BasePart") and not offsets[part] then
				offsets[part] = base:ToObjectSpace(part.CFrame)
			end
		end
	end
	collect()

	local angle = 0
	local function apply(a: number)
		local cf = base * CFrame.Angles(0, 0, -a)
		for part, offset in offsets do
			part.CFrame = cf * offset
		end
	end

	local connection: RBXScriptConnection? = nil
	Net.Event("RouletteSpin").OnClientEvent:Connect(function(index: number, offset: number, _color: string, spinTime: number)
		collect()
		if connection then
			connection:Disconnect()
		end
		local target = (-(index - 1) * segAngle + offset * segAngle) % TAU
		local current = angle % TAU
		local diff = (target - current) % TAU
		local startAngle = angle
		local finalAngle = angle + 5 * TAU + diff
		local started = os.clock()
		local duration = math.max(1, spinTime - 0.8)
		local lastSeg = math.floor(angle / segAngle)
		connection = RunService.RenderStepped:Connect(function()
			local t = math.clamp((os.clock() - started) / duration, 0, 1)
			local eased = 1 - (1 - t) ^ 4
			angle = startAngle + (finalAngle - startAngle) * eased
			apply(angle)
			local seg = math.floor(angle / segAngle)
			if seg ~= lastSeg then
				lastSeg = seg
				local camera = Workspace.CurrentCamera
				if camera and (camera.CFrame.Position - base.Position).Magnitude < 90 then
					Sounds.Play("Tick", 0.2, 1.6)
				end
			end
			if t >= 1 and connection then
				connection:Disconnect()
				connection = nil
			end
		end)
	end)
end

local function setupSpinners()
	local spinners: { BasePart } = {}
	local function consider(inst: Instance)
		if inst:IsA("BasePart") and inst:GetAttribute("Spin") then
			table.insert(spinners, inst)
		end
	end
	for _, inst in Workspace:GetDescendants() do
		consider(inst)
	end
	Workspace.DescendantAdded:Connect(consider)
	local bases: { [BasePart]: CFrame } = {}
	local elapsed = 0
	RunService.RenderStepped:Connect(function(dt)
		elapsed += dt
		for i = #spinners, 1, -1 do
			local part = spinners[i]
			if not part.Parent then
				table.remove(spinners, i)
			else
				local baseCf = bases[part]
				if not baseCf then
					baseCf = part.CFrame
					bases[part] = baseCf
				end
				local speed = part:GetAttribute("Spin") or 1
				part.CFrame = baseCf * CFrame.Angles(0, elapsed * speed, 0) + Vector3.new(0, math.sin(elapsed * 1.5) * 1.2, 0)
			end
		end
	end)
end

function WheelView.Init()
	task.spawn(setupWheel)
	task.spawn(setupSpinners)
end

return WheelView
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Teams" referent="43">
    <Properties>
      <string name="Name">Teams</string>
    </Properties>
  </Item>
